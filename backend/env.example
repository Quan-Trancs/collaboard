# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/collaboard

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Server
PORT=3001
NODE_ENV=development

# JWT — generate a long random secret for any shared or production environment
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=7d

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate limiting (off in development unless RATE_LIMIT_ENABLED=true)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Development seed (ignored when NODE_ENV=production)
DEV_SEED_EMAIL=slide@example.com
DEV_SEED_PASSWORD=devpass123
DEV_SEED_NAME=Slide User
